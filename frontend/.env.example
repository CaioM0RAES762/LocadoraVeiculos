# URL base da API. Deixe vazio para usar o proxy do Vite (/api -> VITE_API_PROXY_TARGET).
# Para chamar a API diretamente (exige CORS liberado para a origem do frontend), use por exemplo:
# VITE_API_URL=http://localhost:5000
VITE_API_URL=

# Destino do proxy de desenvolvimento/preview (usado apenas pelo servidor do Vite).
VITE_API_PROXY_TARGET=http://localhost:5000
